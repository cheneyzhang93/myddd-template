<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.acme.shop</groupId>
        <artifactId>myddd-template</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>shop-bootstrap</artifactId>
    <name>shop-bootstrap</name>
    <description>装配与启动模块：应用入口、鉴权/权限数据源 bean、application.yml、架构守卫测试与端到端测试。</description>

    <dependencies>
        <dependency>
            <groupId>com.acme.shop</groupId>
            <artifactId>shop-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.acme.shop</groupId>
            <artifactId>shop-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Web：统一返回体、全局异常、traceId -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 能力注解（@RequiresPermission/@Idempotent/@RateLimit/@Cacheable）全靠切面生效。
             Boot 4 已没有 spring-boot-starter-aop（改名为 spring-boot-starter-aspectj），
             而 persistence/consistency/resilience 三个 starter 都带 org.aspectj:aspectjweaver，
             Advice 在类路径上时 Boot 的 AopAutoConfiguration 自动开 AspectJ 代理，这里无需再加依赖。 -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-web-starter</artifactId>
        </dependency>

        <!-- 鉴权：壳 + Sa-Token provider；sa-token-spring-boot4-starter 负责把 StpInterface bean 递给 SaManager -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-auth-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-auth-satoken-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 口令散列与鉴权 provider 无关：只取 spring-security 的加密工具，不引入 auth-security-starter -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 缓存：本样例不接 Redis，退到进程内 Caffeine（myddd.cache.type=caffeine） -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-cache-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- 一致性：幂等走 DB 占位表；分布式锁（Redisson）不在样例依赖里，配置面同样显式关闭 -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-consistency-starter</artifactId>
        </dependency>

        <!-- 限流：切面在 myddd-resilience-starter，规则由 provider 侧的 memory 规则源给。
             样例只引一家，因此无需写 myddd.limiter.provider；仍显式写出，示范切换点。 -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-resilience-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-limiter-sentinel-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-core</artifactId>
        </dependency>

        <!-- 定时任务：只引 spring 一侧 ⇒ 无需写 myddd.job.provider，也不接调度中心 -->
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-job-spring-starter</artifactId>
        </dependency>

        <!-- 数据源：缺省 profile 用 H2（开箱即跑，无外部依赖），devbox/mysql profile 用 MySQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Boot 4 把测试切片按技术拆分：spring-boot-starter-test 不再带 MockMvc 侧的
             @AutoConfigureMockMvc（类在 spring-boot-webmvc-test，包名 org.springframework.boot.webmvc.test.autoconfigure），
             web 切片要用 webmvc 专用起步器。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-test-starter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.deep361.myddd</groupId>
            <artifactId>myddd-archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
